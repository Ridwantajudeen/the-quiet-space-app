{
  "expo": {
    "name": "The Quiet Space",
    "slug": "the-quiet-space",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quiet-logo.png",
    "scheme": "thequietspace",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.thequietspace.app",
      "deploymentTarget": "15.0",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We use the microphone so you can record voice journal entries.",
        "NSPhotoLibraryUsageDescription": "We use your photo library so you can choose a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "We save your selected profile photo to your library if you choose to.",
        "NSUserNotificationUsageDescription": "We use notifications to send gentle reminders, shared space invites, and daily reset updates.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thequietspace.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/quiet-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9617acf-668e-4aaa-ba0b-77813fd0e0b3"
      }
    },
    "owner": "ridwan-tajudeen"
  }
}
